# Holo Card 产物的大体积中间包，不进 git（演示只靠 job/assets/ + 上层展示图）
holo-card/*/job/card.zip
holo-card/*/job/alpha-inputs/
holo-card/*/job/raw/
holo-card/*/job/masks/
holo-card/*/job/original.png
# job/source.png 是流水线工作副本；展示用参考图放卡目录根的 source.png / source.webp（要进 git）
holo-card/*/job/source.png
holo-card/*/job/*_raw.*
holo-card/*/job/*_mask.*
holo-card/*/job/*whitecheck*
holo-card/**/*.blend
holo-card/*/renders/

# 卡目录根的拆层中间件（正式展示用 *.webp / source.png）
holo-card/*/*-raw.*
holo-card/*/*-mask.*
holo-card/*/*-preview-*.*
holo-card/*/center-crop.*
holo-card/*/front-exact.*
holo-card/*/original-hd.*
holo-card/*/source-work.*
holo-card/*/front.webp

# RuiC 3D 卡：便携 Blender 运行时与前端依赖，不进 git
holo-card/*/tools/
holo-card/*/web/node_modules/
holo-card/*/job/web/node_modules/
*.log

# 备份与本地目录
*.bak
.workbuddy
.DS_Store
.claude/
__pycache__/
*.pyc
.deploy-archive.zip
.deploy-check.zip
